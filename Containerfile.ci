# CI Analysis Container
# Runs the full nightly analysis pipeline + Claude Code agent for deep analysis.
#
# Build: podman build -f Containerfile.ci -t pipeline-test-analyzer .
# Run:   podman run --env-file .env -e BUILD_NUMBER=1571 -e PRODUCT=rhoai pipeline-test-analyzer

FROM registry.redhat.io/ubi9/python-311:9.6 AS builder

USER 0

# Detect architecture for multi-arch binary downloads
ARG TARGETARCH
RUN echo "Building for architecture: ${TARGETARCH:-$(uname -m)}"

# System packages (--allowerasing: UBI9 ships curl-minimal which conflicts with curl)
RUN dnf install -y --nodocs --allowerasing \
        git \
        curl \
        jq \
        tar \
        gzip \
        skopeo \
    && dnf clean all

# yq (YAML processor — required by tracer)
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then YQ_ARCH="arm64"; else YQ_ARCH="amd64"; fi && \
    curl -sL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${YQ_ARCH}" \
        -o /usr/local/bin/yq && \
    chmod +x /usr/local/bin/yq

# oc CLI (4.19 stable) — architecture-aware
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        OC_ARCH="arm64"; \
    else \
        OC_ARCH="amd64"; \
    fi && \
    curl -sL "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable-4.19/openshift-client-linux-${OC_ARCH}-rhel9.tar.gz" \
    | tar xz -C /usr/local/bin oc kubectl && \
    chmod +x /usr/local/bin/oc /usr/local/bin/kubectl

# gh CLI — architecture-aware
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then \
        GH_ARCH="arm64"; \
    else \
        GH_ARCH="amd64"; \
    fi && \
    GH_VERSION=$(curl -sI "https://github.com/cli/cli/releases/latest" | grep -i location | sed 's/.*tag\/v//;s/\r//') && \
    curl -sL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${GH_ARCH}.tar.gz" \
    | tar xz --strip-components=1 -C /usr/local && \
    chmod +x /usr/local/bin/gh

# Tracer tool (image metadata extraction for RHOAI/ODH builds)
RUN mkdir -p /usr/local/share/tracer && \
    curl -sL "https://raw.githubusercontent.com/red-hat-data-services/rhods-devops-infra/main/tools/tracer/tracer.sh" \
        -o /usr/local/share/tracer/tracer.sh && \
    chmod +x /usr/local/share/tracer/tracer.sh

# Node.js 20 LTS (for Claude Code CLI)
RUN dnf module enable -y nodejs:20 && \
    dnf install -y --nodocs nodejs npm && \
    dnf clean all

# Claude Code CLI + Kubernetes MCP server
RUN npm install -g @anthropic-ai/claude-code kubernetes-mcp-server

# Python dependencies
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ---------- Runtime ----------
FROM registry.redhat.io/ubi9/python-311:9.6

USER 0

# Copy system packages and CLIs from builder
COPY --from=builder /usr/local/bin/oc /usr/local/bin/oc
COPY --from=builder /usr/local/bin/kubectl /usr/local/bin/kubectl
COPY --from=builder /usr/local/bin/gh /usr/local/bin/gh

# Copy Node.js + Claude Code + K8s MCP server from builder
COPY --from=builder /usr/bin/node /usr/bin/node
COPY --from=builder /usr/bin/npm /usr/bin/npm
COPY --from=builder /usr/bin/npx /usr/bin/npx
COPY --from=builder /usr/lib/node_modules /usr/lib/node_modules
COPY --from=builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=builder /usr/local/bin/claude /usr/local/bin/claude
COPY --from=builder /usr/local/bin/kubernetes-mcp-server /usr/local/bin/kubernetes-mcp-server

# Install git, jq, skopeo (needed at runtime for odh-dashboard clone, test reruns, and tracer)
RUN dnf install -y --nodocs --allowerasing git jq curl skopeo && dnf clean all

# Copy yq and tracer from builder
COPY --from=builder /usr/local/bin/yq /usr/local/bin/yq
COPY --from=builder /usr/local/share/tracer/tracer.sh /usr/local/bin/tracer.sh

# Copy Python site-packages from builder
COPY --from=builder /opt/app-root/lib/python3.11/site-packages /opt/app-root/lib/python3.11/site-packages

WORKDIR /app

# Copy project source
COPY analyzer/ ./analyzer/
COPY scripts/ ./scripts/
COPY mcp/ ./mcp/
COPY CLAUDE.md ./
COPY .claude/settings.json ./.claude/settings.json
COPY .claude/settings.ci.json ./.claude/settings.local.json

# Reports directory
RUN mkdir -p reports/current/RHOAI reports/current/ODH reports/historical

# Workspace for cloned repos
RUN mkdir -p /workspace

# Pre-trust the /app workspace and ensure writable home
# MCP servers (Slack, K8s) are configured dynamically by ci_entrypoint.py at runtime
RUN HOME_DIR=/opt/app-root/src && \
    mkdir -p "$HOME_DIR/.claude" && \
    echo '{"projects":{"/app":{"hasTrustDialogAccepted":true}}}' > "$HOME_DIR/.claude.json" && \
    chown -R 1001:0 /app /workspace "$HOME_DIR/.claude" "$HOME_DIR/.claude.json" && \
    chmod -R g=u /app /workspace "$HOME_DIR/.claude" "$HOME_DIR/.claude.json"

ENV PYTHONUNBUFFERED=1
ENV REPORT_OUTPUT_DIR=/app/reports
ENV TRACER_PATH=/usr/local/bin/tracer.sh

# Run as non-root (required by Claude Code --dangerously-skip-permissions)
USER 1001

ENTRYPOINT ["python", "scripts/ci_entrypoint.py"]
